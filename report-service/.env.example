# Copy to .env (git-ignored) and fill in. Real environment variables override values in this file.

# Service user credentials (required). The client ID is shown on the service user in the manager UI / Keycloak.
OR_CLIENT_ID=
OR_CLIENT_SECRET=

# Optional. Defaults shown; see README.md.
#OR_MANAGER=http://127.0.0.1:8080
#OR_KEYCLOAK=http://127.0.0.1:8081/auth
#OR_REALM=master
#PORT=5000

# The folder in which the saved reports are kept: a JSON file for each report, in a folder for each realm. It is made if
# it is not there, and is relative to the folder the service is started from. See "Saved reports" in README.md.
#REPORTS_DIR=data/reports

# Serve every realm: register as a global service that the manager shows in every realm. Needs OR_REALM=master and a
# service user that is a super user (realm role admin); see "Serving every realm" in README.md.
#OR_GLOBAL_SERVICE=true

# The model that writes the text of a report: any API that is compatible with OpenAI's, hosted or on your own machine.
# Set the address and the model together, or neither: without them AI text is switched off. The key is for a hosted
# API; a local one (Ollama) needs none. See "AI text" in README.md.
#AI_BASE_URL=https://api.anthropic.com/v1
#AI_MODEL=claude-haiku-5-5
#AI_API_KEY=
#AI_TIMEOUT_SECONDS=30

# Local testing only: accept self-signed TLS certificates (e.g. the docker proxy on https://localhost), also in the
# browser that makes the PDFs.
#OR_INSECURE_TLS=true
