# Copy to .env (git-ignored) and fill in. Real environment variables override values in this file.

# Service user credentials (required). The client ID is shown on the service user in the manager UI / Keycloak.
OR_CLIENT_ID=
OR_CLIENT_SECRET=

# Optional. Defaults shown; see README.md.
#OR_MANAGER=http://127.0.0.1:8080
#OR_KEYCLOAK=http://127.0.0.1:8081/auth
#OR_REALM=master
#PORT=5000

# Serve every realm: register as a global service that the manager shows in every realm. Needs OR_REALM=master and a
# service user that is a super user (realm role admin); see "Serving every realm" in README.md.
#OR_GLOBAL_SERVICE=true

# Local testing only: accept self-signed TLS certificates (e.g. the docker proxy on https://localhost).
#OR_INSECURE_TLS=true
